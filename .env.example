# FarmDirect — Environment Variables
# Copy this to .env to connect to the shared database

# ── PostgreSQL (Shared Neon Cloud) ───────────────────────────────────────────
# Both Raajveer and Ayush connect to this shared Neon serverless PostgreSQL database:
DATABASE_URL="postgresql://neondb_owner:npg_mHb8LrOW0toV@ep-dark-unit-a7ia81qu-pooler.ap-southeast-2.aws.neon.tech/neondb?sslmode=require"

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5001

# ── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET=farmdirect-dev-secret
JWT_EXPIRES_IN=86400

# ── OTP Configuration ───────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10

# ── CORS ─────────────────────────────────────────────────────────────────────
# Set to your frontend domain in production (e.g., https://farmdirect.app)
CORS_ORIGIN=*

# ── Email (optional, for OTP delivery) ──────────────────────────────────────
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-app-password

