# FarmDirect — Environment Variables
# Copy this to .env and fill in your values

# ── PostgreSQL (Neon Cloud) ──────────────────────────────────────────────────
# Connection string for your Neon database
DATABASE_URL="postgresql://your_user:your_password@your-host.neon.tech/neondb?sslmode=require"

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5001

# ── JWT Authentication ───────────────────────────────────────────────────────
# IMPORTANT: Change this to a secure random string in production
JWT_SECRET=farmdirect-change-me-in-production
JWT_EXPIRES_IN=86400

# ── OTP Configuration ───────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10

# ── CORS ─────────────────────────────────────────────────────────────────────
# Set to your frontend domain in production (e.g., https://farmdirect.app)
CORS_ORIGIN=*

# ── Email (optional, for OTP delivery) ──────────────────────────────────────
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-app-password
